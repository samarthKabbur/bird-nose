# Machine-local settings for containers/compose.yaml.
# tools/setup_env.sh copies this to containers/.env and fills in the IDs.
# containers/.env is ignored by Git: put addresses and secrets only there.

# Must match your host user so files created in the repository stay yours.
HOST_UID=1000
HOST_GID=1000
CONTAINER_USER=dev

# ROS settings for development and simulation.
# 42 keeps this machine's sessions off the robot's domain (0).
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# LOCALHOST keeps simulation traffic on this machine.
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# X11 display for Gazebo and RViz windows.
DISPLAY=:0
