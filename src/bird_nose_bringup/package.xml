  <version>0.0.1</version>
  <description>Launch entry points for the Bird Nose robot in simulation (and later on hardware).</description>
  <maintainer email="samarthKabbur@users.noreply.github.com">Samarth Kabbur</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>clearpath_gz</exec_depend>
  <exec_depend>clearpath_nav2_demos</exec_depend>
  <exec_depend>clearpath_viz</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
