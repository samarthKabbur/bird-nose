# --- Colcon workspace output (the repo root is the workspace) ---
/build/
/install/
/log/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Local, machine-specific settings (never committed) ---
# Copy containers/.env.example to containers/.env and edit locally.
.env
containers/.env
containers/compose.override.yaml
*.local.yaml

# --- Recordings, logs, and reports (kept outside Git) ---
data/**
!data/*/
!data/*/.gitkeep
!data/README.md
*.mcap
*.db3
*.bag

# --- Simulator and tool state ---
.gz/
.ros/
.cache/

# --- Editors and OS ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
