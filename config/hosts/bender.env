# bender: secondary onboard computer (Ubuntu 22.04 host, Jazzy in containers).
# Runs Bird Nose nodes and sensor drivers that need more CPU or the GPU;
# hosts the 16SoundsUSB microphone array. Final allocation: Phase 5.
ROLE=bender
ROS_DOMAIN_ID=0
ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
